{
  "name": "resqroad",
  "version": "2.0.0",
  "private": true,
  "description": "Road damage reporting and maintenance management system (web).",
  "type": "module",
  "scripts": {
    "start": "node serve.js",
    "seed": "node tools/seed.js",
    "deploy": "firebase deploy --only hosting,firestore",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:bootstrap-rules": "firebase deploy --only firestore:rules --config firebase.bootstrap.json"
  },
  "devDependencies": {
    "firebase": "12.19.0"
  }
}
