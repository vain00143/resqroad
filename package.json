{
  "name": "resqroad",
  "version": "3.0.0",
  "private": true,
  "description": "Road damage reporting and maintenance management system: website, API, and live updates backed by MySQL.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node serve.js",
    "dev": "node --watch serve.js",
    "db:setup": "node tools/db-setup.js",
    "create-admin": "node tools/create-admin.js",
    "seed": "node tools/seed.js",
    "import:firebase": "node tools/import-firebase.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "multer": "2.4.0",
    "mysql2": "3.24.5",
    "ws": "8.22.0"
  }
}
