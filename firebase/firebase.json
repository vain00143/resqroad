{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase*.json",
      "firestore.rules",
      "firestore.indexes.json",
      "package.json",
      "package-lock.json",
      "serve.js",
      "*.md",
      "ResQRoad Brandsheet.*",
      "tools/**",
      "student_login_registration/**",
      ".git/**",
      ".claude/**",
      ".vscode/**",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
