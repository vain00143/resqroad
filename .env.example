# Copy this file to .env and fill in your MySQL details. .env is never
# committed. These defaults are for MySQL 8.0 on this computer: set
# DB_PASSWORD to the root password chosen when MySQL was installed (leave it
# empty for XAMPP, whose root user has no password).

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resqroad

# Web server. HOST=0.0.0.0 lets phones and other computers on the same
# network open the site (http://<this computer's IP>:8000/).
HOST=0.0.0.0
PORT=8000

# Set to true when the site is served over HTTPS, so sign-in cookies are
# only ever sent over encrypted connections.
COOKIE_SECURE=false

# Other website origins allowed to call the API with a browser (comma
# separated), e.g. an Expo web build at http://localhost:8081. The mobile app
# itself doesn't need this.
CORS_ORIGINS=
