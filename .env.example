# Copy this file to .env and fill in your MySQL details. .env is never
# committed. These defaults are for MySQL 8.0 on this computer: set
# DB_PASSWORD to the root password chosen when MySQL was installed (leave it
# empty for XAMPP, whose root user has no password).

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=resqroad

# Web server. HOST=0.0.0.0 lets phones and other computers on the same
# network open the site (http://<this computer's IP>:8000/).
HOST=0.0.0.0
PORT=8000

# Set to true when the site is served over HTTPS, so sign-in cookies are
# only ever sent over encrypted connections.
COOKIE_SECURE=false

# Other website origins allowed to call the API with a browser (comma
# separated), e.g. an Expo web build at http://localhost:8081. The mobile app
# itself doesn't need this.
CORS_ORIGINS=

# Behind a hosting proxy (Railway and similar), set to 1 so sign-in limits
# see each visitor's address. Leave empty on this computer.
TRUST_PROXY=

# Where uploaded photos are saved (relative to this folder, or absolute).
# On a host, point it at a persistent volume, e.g. /data/storage.
STORAGE_DIR=storage

# "disk" (default) saves photos under STORAGE_DIR; "database" keeps them in
# MySQL, for hosts without a permanent disk (such as Render's free plan).
PHOTO_STORAGE=disk

# Encrypted MySQL connections, required by hosted databases such as Aiven:
# paste the provider's CA certificate (PEM) into DB_SSL_CA, or set DB_SSL=true
# to trust the system's certificate authorities. Leave both empty locally.
DB_SSL_CA=
DB_SSL=
